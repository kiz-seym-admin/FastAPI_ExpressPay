# ── Express-Pay ───────────────────────────────────────────────────────────────
# Тестовый токен Sandbox Express-Pay (официальный, из документации):
EP_TOKEN=a75b74cbcfe446509e8ee874f421bd64

# Секретное слово для HMAC-SHA1 подписи (опционально, оставьте пустым для sandbox)
EP_SECRET_WORD=

# true  — использовать sandbox-api.express-pay.by (тест, деньги не списываются)
# false — использовать api.express-pay.by (боевой режим)
EP_IS_TEST=true

# ── Сервис ────────────────────────────────────────────────────────────────────
# При локальной разработке webhook недоступен — используйте ngrok:
#   ngrok http 8000  →  скопируйте HTTPS-адрес сюда
BASE_URL=https://api.kizombaseym.online

# ── JSON-хранилище ────────────────────────────────────────────────────────────
DATA_DIR=/data

# MySQL (совпадают с docker-compose.yml)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=fastapi
MYSQL_PASSWORD=secret
MYSQL_DB=expresspay

DATA_DIR=/data